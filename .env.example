PORT=3000
JWT_SECRET=votre_secret_jwt
# Fichier de la base SQLite, cree au premier demarrage avec le jeu de demonstration
# (defaut : data/tournois.db). ':memory:' : base en memoire, perdue a l'arret.
# Les tests imposent toujours ':memory:'.
DB_PATH=data/tournois.db
FRONT_URL=http://localhost:5173

# Niveau de journalisation : error, warn, info, http, verbose, debug ou silly (defaut : info)
LOG_LEVEL=info

# Connexions echouees autorisees par IP et par tranche de 10 minutes (defaut : 10).
# Les connexions reussies ne sont pas comptees.
# LIMITE_CONNEXIONS=10
